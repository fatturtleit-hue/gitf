{
  "name": "gitf-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --port 4200 --host",
    "dev": "vite --port 4200 --host",
    "build": "vue-tsc --noEmit && vite build",
    "watch": "vue-tsc --noEmit && vite build --watch",
    "preview": "vite preview --port 4200",
    "lint": "eslint . --ext .vue,.ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,css,json}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.7.2",
    "dompurify": "^3.4.11",
    "element-plus": "^2.7.6",
    "highlight.js": "^11.11.1",
    "marked": "^13.0.3",
    "pinia": "^2.1.7",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.14.10",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.27.0",
    "prettier": "^3.3.2",
    "sass": "^1.77.8",
    "typescript": "^5.5.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.3.3",
    "vue-tsc": "^3.3.13"
  }
}
