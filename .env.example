# gitf Configuration
# Copy this file to .env and adjust as needed.
# Full explanation of every variable: GUIDE.md (Chinese operations guide).

# --- Core ---
# Listen address (default: :8080)
ADDR=:8080

# Data directory for repositories and database (default: ./data)
DATA_DIR=./data

# Database driver: sqlite or postgres (default: sqlite)
DB_DRIVER=sqlite

# Database connection string
# For SQLite: ./data/app.db
# For PostgreSQL: postgres://user:pass@localhost:5432/gitf?sslmode=disable
DB_DSN=./data/app.db

# --- Security ---
# JWT signing secret. Auto-generated per start if empty, which invalidates all
# sessions on every restart — set a fixed random value in production.
JWT_SECRET=

# Shared secret that server-side git hooks use to call back into gitf.
# Required for branch-protection enforcement (pre-receive) and webhook
# push dispatch authentication (post-receive). Leave empty in development.
HOOK_SECRET=

# Bootstrap admin account, created on first startup when the database is empty.
# DEFAULT_ADMIN_PASSWORD is required on that first start.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# Set true to disable public self-registration (admin-created accounts only).
# DISABLE_REGISTRATION=false

# --- Webhooks ---
WEBHOOK_WORKERS=4      # delivery worker pool size
WEBHOOK_TIMEOUT=10     # per-delivery timeout, seconds
WEBHOOK_MAX_RETRIES=3  # retry attempts for failed deliveries

# --- Logging ---
LOG_LEVEL=info       # debug, info, warn, error
LOG_FORMAT=json      # json or text

# --- TLS (optional; a reverse proxy is the more common setup) ---
# TLS_ENABLED=true
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem

# --- Debug / diagnostics ---
# HEALTH_LEAK_DETAILS=true  # include DB error details in /health/ready (do NOT enable in production)
# ENABLE_PPROF=true         # expose /debug/pprof/ endpoints (do NOT enable in production)
