package middleware

import (
	"crypto/rand"
	"encoding/base64"
	"net/http"
	"strings"

	"github.com/go-chi/chi/v5"
)

// CSRFTokenLength defines the length of the CSRF token
const CSRFTokenLength = 32

// CSRFStore defines the interface for CSRF token storage
type CSRFStore interface {
	GetToken(r *http.Request) (string, error)
	SetToken(w http.ResponseWriter, token string) error
	ValidateToken(r *http.Request, token string) bool
}

// MemoryCSRFStore implements CSRFStore using in-memory storage
type MemoryCSRFStore struct {
	tokens map[string]string
}

// NewMemoryCSRFStore creates a new in-memory CSRF token store
func NewMemoryCSRFStore() *MemoryCSRFStore {
	return &MemoryCSRFStore{
		tokens: make(map[string]string),
	}
}

// GetToken retrieves a CSRF token from the store
func (s *MemoryCSRFStore) GetToken(r *http.Request) (string, error) {
	cookie, err := r.Cookie("csrf_token")
	if err == nil {
		return cookie.Value, nil
	}
	return "", err
}

// SetToken stores a CSRF token in the cookie
func (s *MemoryCSRFStore) SetToken(w http.ResponseWriter, token string) error {
	http.SetCookie(w, &http.Cookie{
		Name:     "csrf_token",
		Value:    token,
		Path:     "/",
		MaxAge:   3600, // 1 hour
		HttpOnly: false,
		Secure:   true,
		SameSite: http.SameSiteStrictMode,
	})
	return nil
}

// ValidateToken checks if the provided CSRF token matches the stored token
func (s *MemoryCSRFStore) ValidateToken(r *http.Request, token string) bool {
	storedToken, err := s.GetToken(r)
	if err != nil {
		return false
	}
	return storedToken == token
}

// generateCSRFToken creates a new random CSRF token
func generateCSRFToken() (string, error) {
	b := make([]byte, CSRFTokenLength)
	_, err := rand.Read(b)
	if err != nil {
		return "", err
	}
	return base64.URLEncoding.EncodeToString(b), nil
}

// CSRFMiddleware provides CSRF protection for state-changing operations
type CSRFMiddleware struct {
	store CSRFStore
}

// NewCSRFMiddleware creates a new CSRF protection middleware
func NewCSRFMiddleware(store CSRFStore) *CSRFMiddleware {
	return &CSRFMiddleware{store: store}
}

// Handle handles CSRF protection for HTTP requests
func (m *CSRFMiddleware) Handle(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		// Skip CSRF check for safe methods
		if r.Method == http.MethodGet || r.Method == http.MethodHead || r.Method == http.MethodOptions || r.Method == http.MethodTrace {
			next.ServeHTTP(w, r)
			return
		}

		// For API requests, check the CSRF token in the header
		if strings.HasPrefix(r.URL.Path, "/api/") {
			token := r.Header.Get("X-CSRF-Token")
			if token == "" {
				writeAPIError(w, r, http.StatusForbidden, "FORBIDDEN", "CSRF token missing")
				return
			}

			if !m.store.ValidateToken(r, token) {
				writeAPIError(w, r, http.StatusForbidden, "FORBIDDEN", "Invalid CSRF token")
				return
			}

			next.ServeHTTP(w, r)
			return
		}

		// For non-API requests, check the CSRF token in the form
		token := r.FormValue("csrf_token")
		if token == "" {
			writeAPIError(w, r, http.StatusForbidden, "FORBIDDEN", "CSRF token missing")
			return
		}

		if !m.store.ValidateToken(r, token) {
			writeAPIError(w, r, http.StatusForbidden, "FORBIDDEN", "Invalid CSRF token")
			return
		}

		next.ServeHTTP(w, r)
	})
}

// GetCSRFTokenHandler returns a handler that generates and sets a CSRF token
func GetCSRFTokenHandler(store CSRFStore) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		token, err := generateCSRFToken()
		if err != nil {
			writeServerError(w, r, "generate CSRF token", err)
			return
		}

		if err := store.SetToken(w, token); err != nil {
			writeServerError(w, r, "set CSRF token", err)
			return
		}

		writeJSON(w, r, http.StatusOK, map[string]string{
			"csrf_token": token,
		})
	}
}

// CSRFRouter sets up CSRF protection routes
func CSRFRouter(store CSRFStore) *chi.Mux {
	r := chi.NewRouter()
	csrfMiddleware := NewCSRFMiddleware(store)

	// Protected routes
	r.Group(func(r chi.Router) {
		r.Use(csrfMiddleware.Handle)
		// Add protected routes here
	})

	// CSRF token endpoint
	r.Get("/csrf-token", GetCSRFTokenHandler(store))

	return r
}
